# --- AI generation ---
OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-5-mini
# OPENAI_TIMEOUT_MS=45000
# Reasoning models spend output tokens on thinking, so keep this generous.
# OPENAI_MAX_OUTPUT_TOKENS=8000
# OPENAI_REASONING_EFFORT=low   # minimal | low | medium | high (reasoning models)

# --- Retrieval (RAG) ---
# openai: text-embedding-3-small via your OpenAI key. hash: offline, no key,
# no semantic knowledge (used by tests and e2e; not for real use).
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_MODEL=text-embedding-3-small
# RETRIEVAL_TOP_K=6
# RETRIEVAL_MIN_SCORE=0.45   # cosine floor; measured with `npm run knowledge:probe`

# --- Database (Supabase Postgres) ---
# Supabase dashboard -> Connect -> "Transaction pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password (Project Settings ->
# Database). Prisma-only parameters such as ?pgbouncer=true are ignored.
#
# Port 6543 is the transaction pooler (best for serverless deploys). Some
# networks silently drop it; if `npm run db:check` times out, use the session
# pooler on port 5432 instead, which behaves the same for this app.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# --- Sessions ---
# Signs the demo session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-random-characters

# --- Abuse protection for the public demo ---
# GENERATION_LIMIT_PER_HOUR=10
# GENERATION_DAILY_CAP=200
# GENERATION_IP_LIMIT_PER_HOUR=5   # per visitor address
# RATE_LIMIT_SALT=change-me

# --- Deployment only ---
# Authorises the nightly reset (Vercel Cron sends it as a bearer token).
# CRON_SECRET=generate-with-openssl-rand-hex-24
# Keep the pool at 1 behind the transaction pooler on serverless.
# DATABASE_POOL_MAX=1
